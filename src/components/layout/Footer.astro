---
import Logo from '../brand/Logo.astro';
import ContentTag from '../review/ContentTag.astro';
import { Icon } from 'astro-icon/components';
import type siteData from '../../data/site.json';

interface Props {
  site: typeof siteData;
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <!-- Logo -->
    <div class="footer-brand">
      <a href="/" aria-label="WM Argentina — inicio" class="footer-logo-link">
        <Logo variant="vertical-color" width={84} />
      </a>
    </div>

    <!-- Contacto y sedes (D-06: datos provisorios del sitio actual) -->
    <div class="footer-contact">
      <p class="footer-heading">
        Contacto
        <ContentTag status="validar" label="Validar" note="Datos del sitio anterior — confirmar vigencia (P-06)" />
      </p>
      {site.contact?.phone?.map((p) => (
        <p class="footer-icon-row">
          <Icon name="lucide:phone" size={14} class="footer-icon" aria-hidden="true" />
          <a href={`tel:${p.replace(/[^+\d]/g, '')}`}>{p}</a>
        </p>
      ))}
      {site.contact?.email === 'TODO-CLIENTE'
        ? <p class="footer-muted"><ContentTag status="falta" label="Mail — Falta" note="Mail comercial a definir (P-06)" /></p>
        : site.contact?.email && <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      }
      {site.contact?.hours && (
        <>
          <p class="footer-subheading">Horarios</p>
          <p class="footer-icon-row">
            <Icon name="lucide:clock" size={14} class="footer-icon" aria-hidden="true" />
            {site.contact.hours}
          </p>
        </>
      )}
    </div>

    <!-- Sedes -->
    <div class="footer-offices">
      <p class="footer-heading">Sedes</p>
      {site.offices.map((o) => (
        <p class="footer-icon-row footer-office-row">
          <Icon name="lucide:map-pin" size={14} class="footer-icon footer-icon--top" aria-hidden="true" />
          <span>
            <strong>{o.name}</strong>
            {o.address === 'TODO-CLIENTE'
              ? <><br /><ContentTag status="falta" label="Dirección — Falta" note={`Dirección de sede ${o.name} (P-06)`} /></>
              : <><br />{o.address}</>
            }
          </span>
        </p>
      ))}
    </div>

    <!-- Links -->
    <div class="footer-links">
      <p class="footer-heading">Más información</p>
      <ul role="list">
        <li><a href="/su-socio-en-argentina">Su Socio en Argentina</a></li>
        <li><a href="/trabaja-con-nosotros">Trabajá con Nosotros</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
        <li><a href="/terminos">Términos y Condiciones</a></li>
        <li><a href="/cookies">Política de Cookies</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} WM Argentina. Todos los derechos reservados.</p>
      <p class="footer-credit">Desarrollado por <a href="https://harvi.digital" target="_blank" rel="noopener noreferrer" class="footer-credit-link">Harvi Digital</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--wm-blue);
    color: #fff;
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 150px 1.5fr 2.5fr 1fr;
      align-items: start;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 50%;
    width: 116px;
    height: 116px;
    line-height: 0;
    flex-shrink: 0;
  }

  .footer-logo-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .footer-subheading {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.9);
    margin: 0.875rem 0 0.25rem;
  }

  .footer-heading {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.9);
    margin: 0 0 0.75rem;
  }

  .footer-contact p,
  .footer-offices p {
    margin: 0.25rem 0;
    font-size: 0.9375rem;
  }

  .footer-icon-row {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .footer-icon {
    color: #fff;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .footer-icon--top {
    margin-top: 0.25rem;
  }

  .footer-muted {
    opacity: 0.75;
    font-size: 0.875rem !important;
  }

  .site-footer a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .footer-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links li a {
    font-size: 0.9375rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255 255 255 / 0.2);
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .footer-credit {
    opacity: 0.5 !important;
    font-size: 0.8125rem !important;
  }

  .footer-credit-link {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
