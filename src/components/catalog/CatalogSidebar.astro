---
import type { CatalogIndex } from '../../lib/catalog';
import { APPLICATION_LABELS } from '../../data/applicationLabels';

interface Props {
  index: CatalogIndex;
}

const { index } = Astro.props;

const kindLabels: Record<string, string> = {
  instrument:  'Instrumento',
  reagent:     'Reactivo',
  consumable:  'Consumible',
  control:     'Control',
  calibrator:  'Calibrador',
  software:    'Software',
  accessory:   'Accesorio',
};

function instrumentFamily(name: string): string {
  if (/^ACL TOP|^ACL Elite|^ACL AcuStar/.test(name)) return 'Familia ACL TOP';
  if (/^microINR/.test(name)) return 'Familia microINR';
  return 'Otros';
}

const instrumentFamilies: Map<string, typeof index.instruments> = new Map();
for (const instr of index.instruments) {
  const fam = instrumentFamily(instr.name);
  const existing = instrumentFamilies.get(fam) ?? [];
  existing.push(instr);
  instrumentFamilies.set(fam, existing);
}
const FAMILY_ORDER = ['Familia ACL TOP', 'Familia microINR', 'Otros'];

const orderedLines = index.lines.filter((l) => index.analytesByLine[l.id]?.length > 0);
---

<aside id="catalog-sidebar" aria-label="Filtros del catálogo">

  {/* ── Panel: por analito ──────────────────────────────────────────── */}
  <div class="sidebar-panel" data-via="analito">
    <p class="sidebar-panel-title">Analito</p>

    <div class="sidebar-search-wrap">
      <input
        class="sidebar-search"
        data-panel="analito"
        type="search"
        placeholder="Buscar analito…"
        autocomplete="off"
        aria-label="Filtrar analitos"
      />
    </div>

    {orderedLines.map((line, i) => {
      const analytes = index.analytesByLine[line.id];
      return analytes?.length ? (
        <details class="sidebar-details" open={i === 0}>
          <summary class="sidebar-details-summary">{line.name}</summary>
          <div class="sidebar-details-body">
            {analytes.map((analyte) => (
              <button class="sidebar-item" data-via="analito" data-q={analyte} type="button">
                {analyte}
              </button>
            ))}
          </div>
        </details>
      ) : null;
    })}
  </div>

  {/* ── Panel: por instrumento ──────────────────────────────────────── */}
  <div class="sidebar-panel" data-via="instrumento">
    <p class="sidebar-panel-title">Instrumento</p>
    {FAMILY_ORDER.map((fam, i) => {
      const instrs = instrumentFamilies.get(fam);
      return instrs?.length ? (
        <details class="sidebar-details" open={i === 0}>
          <summary class="sidebar-details-summary">{fam}</summary>
          <div class="sidebar-details-body">
            {instrs.map((instr) => (
              <button class="sidebar-item" data-via="instrumento" data-q={instr.slug} type="button">
                {instr.name}
              </button>
            ))}
          </div>
        </details>
      ) : null;
    })}
  </div>

  {/* ── Panel: por aplicación ───────────────────────────────────────── */}
  <div class="sidebar-panel" data-via="aplicacion">
    <p class="sidebar-panel-title">Aplicación clínica</p>

    <div class="sidebar-search-wrap">
      <input
        class="sidebar-search"
        data-panel="aplicacion"
        type="search"
        placeholder="Buscar aplicación…"
        autocomplete="off"
        aria-label="Filtrar aplicaciones"
      />
    </div>

    <div class="sidebar-aplicacion-list">
      {index.applications.map((slug) => (
        <button class="sidebar-item" data-via="aplicacion" data-q={slug} type="button">
          {APPLICATION_LABELS[slug] ?? slug}
        </button>
      ))}
    </div>
  </div>

  {/* ── Panel: ver todo (checkboxes) ───────────────────────────────── */}
  <div class="sidebar-panel" data-via="todo">

    <details class="sidebar-details" open>
      <summary class="sidebar-details-summary">Tipo</summary>
      <div class="sidebar-details-body">
        {Object.entries(kindLabels).map(([value, label]) => (
          <label class="sidebar-check-label">
            <input type="checkbox" class="sidebar-filter-check" data-dimension="kind" data-q={value} />
            {label}
          </label>
        ))}
      </div>
    </details>

    <details class="sidebar-details">
      <summary class="sidebar-details-summary">Línea</summary>
      <div class="sidebar-details-body">
        {index.lines.map((line) => (
          <label class="sidebar-check-label">
            <input type="checkbox" class="sidebar-filter-check" data-dimension="line" data-q={line.id} />
            {line.name}
          </label>
        ))}
      </div>
    </details>

    <details class="sidebar-details">
      <summary class="sidebar-details-summary">Marca</summary>
      <div class="sidebar-details-body">
        {index.manufacturers.map((mfg) => (
          <label class="sidebar-check-label">
            <input type="checkbox" class="sidebar-filter-check" data-dimension="manufacturer" data-q={mfg.id} />
            {mfg.name}
          </label>
        ))}
      </div>
    </details>

    <details class="sidebar-details">
      <summary class="sidebar-details-summary">Compatibilidad</summary>
      <div class="sidebar-details-body">
        <label class="sidebar-check-label">
          <input type="checkbox" class="sidebar-filter-check" data-dimension="compatibility" data-q="open" />
          Sistema abierto
        </label>
        <label class="sidebar-check-label">
          <input type="checkbox" class="sidebar-filter-check" data-dimension="compatibility" data-q="specific" />
          Específica
        </label>
      </div>
    </details>

  </div>

</aside>

<script>
  // Filter sidebar items by text within a panel
  document.querySelectorAll<HTMLInputElement>('.sidebar-search').forEach((input) => {
    input.addEventListener('input', () => {
      const val = input.value.trim().toLowerCase();
      const panel = input.dataset.panel;
      if (!panel) return;

      const panelEl = document.querySelector(`.sidebar-panel[data-via="${panel}"]`);
      if (!panelEl) return;

      panelEl.querySelectorAll<HTMLElement>('.sidebar-item').forEach((item) => {
        const text = item.textContent?.toLowerCase() ?? '';
        const matches = !val || text.includes(val);
        item.hidden = !matches;

        // auto-open parent details if there's a match
        if (matches && val) {
          item.closest('details')?.setAttribute('open', '');
        }
      });

      // hide empty details groups
      panelEl.querySelectorAll('details').forEach((d) => {
        const hasVisible = Array.from(d.querySelectorAll<HTMLElement>('.sidebar-item')).some(
          (b) => !b.hidden
        );
        d.hidden = !hasVisible && val.length > 0;
      });
    });
  });
</script>

<style>
  #catalog-sidebar {
    min-width: 0;
  }

  /* show/hide panels — must live here so scoped hash matches */
  .sidebar-panel { display: none; }
  .sidebar-panel.is-active { display: block; }

  .sidebar-panel-title {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--wm-text-muted);
    margin: 0 0 0.5rem;
  }

  /* ── Search filter ──────────────────────────────────────────────── */
  .sidebar-search-wrap {
    margin-bottom: 0.5rem;
  }

  .sidebar-search {
    width: 100%;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--wm-border);
    border-radius: 6px;
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    color: var(--wm-text);
    background: var(--wm-bg);
    outline: none;
    transition: border-color 0.12s;
  }

  .sidebar-search:focus { border-color: var(--wm-blue); }

  /* ── Collapsible groups ─────────────────────────────────────────── */
  .sidebar-details {
    margin-bottom: 0.25rem;
    border-radius: 6px;
    overflow: hidden;
  }

  .sidebar-details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--wm-text);
    cursor: pointer;
    border-radius: 6px;
    user-select: none;
    list-style: none;
    background: var(--wm-bg-soft);
    transition: background 0.12s;
    min-height: var(--tap-min);
  }

  .sidebar-details-summary::-webkit-details-marker { display: none; }

  .sidebar-details-summary::after {
    content: '›';
    font-size: 1rem;
    line-height: 1;
    color: var(--wm-text-muted);
    transform: rotate(90deg);
    transition: transform 0.2s;
    display: inline-block;
  }

  .sidebar-details[open] > .sidebar-details-summary::after {
    transform: rotate(270deg);
  }

  .sidebar-details-summary:hover { background: var(--wm-blue-tint); color: var(--wm-blue); }
  .sidebar-details[open] > .sidebar-details-summary { background: var(--wm-blue-tint); color: var(--wm-blue); }

  .sidebar-details-body {
    padding: 0.25rem 0 0.25rem;
  }

  /* ── Sidebar items ──────────────────────────────────────────────── */
  .sidebar-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.375rem 1rem;
    border: none;
    background: transparent;
    border-radius: 6px;
    font-size: 0.875rem;
    font-family: var(--font-sans);
    color: var(--wm-text);
    cursor: pointer;
    min-height: var(--tap-min);
    transition: background 0.12s, color 0.12s;
  }

  .sidebar-item:hover { background: var(--wm-blue-tint); color: var(--wm-blue); }
  .sidebar-item.is-active { background: var(--wm-blue); color: #fff; }

  /* ── Aplicacion flat list ───────────────────────────────────────── */
  .sidebar-aplicacion-list {
    display: flex;
    flex-direction: column;
  }

  /* ── Checkboxes ─────────────────────────────────────────────────── */
  .sidebar-check-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 1rem;
    font-size: 0.875rem;
    color: var(--wm-text);
    cursor: pointer;
    min-height: var(--tap-min);
    border-radius: 6px;
    transition: background 0.12s;
  }

  .sidebar-check-label:hover { background: var(--wm-blue-tint); }

  .sidebar-filter-check {
    width: 1rem;
    height: 1rem;
    accent-color: var(--wm-blue);
    flex-shrink: 0;
  }
</style>
