---
import Base from '../layouts/Base.astro';
---

<Base title="Términos de uso" robots="noindex,nofollow">
  <section class="page-hero">
    <div class="container">
      <h1>Términos de uso</h1>
    </div>
  </section>
  <section class="section">
    <div class="container content-layout">
      <p class="placeholder">TODO-CLIENTE (D-19, P-27) — Texto legal de términos de uso pendiente de validación por el cliente.</p>
    </div>
  </section>
</Base>

<style>
  .page-hero { background: var(--wm-blue); color: #fff; padding-block: 3rem; }
  .page-hero h1 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0; }
  .section { padding-block: 4rem; }
  .content-layout { max-width: 720px; }
  .placeholder { color: var(--wm-text-muted); font-style: italic; }
</style>
