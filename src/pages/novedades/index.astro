---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/layout/Cta.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const sections = [
  { id: 'novedades', label: 'Novedades' },
  { id: 'eventos', label: 'Eventos' },
  { id: 'cientifico', label: 'Contenido Científico' },
  { id: 'empresas', label: 'Empresas Representadas' },
] as const;
---

<Base
  title="Novedades y Conocimiento"
  description="Novedades, eventos, contenido científico y empresas representadas de WM Argentina."
>
  <section class="page-hero">
    <div class="container">
      <h1>Novedades y Conocimiento</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Filtros por sección (RF-32) -->
      <div class="filter-bar">
        <button class="filter-btn is-active" data-section="all">Todas</button>
        {sections.map((s) => (
          <button class="filter-btn" data-section={s.id}>{s.label}</button>
        ))}
      </div>

      <!-- Buscador por palabra clave (RF-32) -->
      <div class="search-bar">
        <label for="keyword-search" class="sr-only">Buscar por palabra clave</label>
        <input
          type="search"
          id="keyword-search"
          placeholder="Buscar por palabra clave…"
          class="keyword-input"
          aria-controls="posts-grid"
        />
      </div>

      <ul id="posts-grid" class="posts-grid" role="list">
        {posts.map((post) => (
          <li data-section={post.data.section} data-tags={post.data.tags.join(',').toLowerCase()} data-title={post.data.title.toLowerCase()}>
            <a href={`/novedades/${post.data.slug}`} class="post-card">
              {post.data.image && (
                <div class="post-card__image">
                  <img
                    src={post.data.image}
                    alt=""
                    width="400"
                    height="225"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="post-card__body">
                <div class="post-card__meta">
                  <span class="post-card__section">{sections.find(s => s.id === post.data.section)?.label ?? post.data.section}</span>
                  <time datetime={post.data.date} class="post-card__date">
                    {new Date(post.data.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <h2 class="post-card__title">{post.data.title}</h2>
                <p class="post-card__excerpt">{post.data.excerpt !== 'TODO-CLIENTE' ? post.data.excerpt : ''}</p>
                <span class="post-card__cta" aria-hidden="true">Leer más →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      {posts.length === 0 && (
        <p class="empty-state">TODO-CLIENTE — Publicaciones en preparación (P-21).</p>
      )}
    </div>
  </section>

  <Cta
    title="¿Querés hablar con un especialista?"
    body="Nuestro equipo está listo para asesorarte sobre diagnóstico y soluciones."
    primary={{ label: 'Contactar un especialista', href: '/contacto' }}
  />
</Base>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLLIElement>('#posts-grid li');
  const searchInput = document.getElementById('keyword-search') as HTMLInputElement | null;

  let activeSection = 'all';
  let keyword = '';

  function applyFilters() {
    items.forEach((item) => {
      const matchSection = activeSection === 'all' || item.dataset.section === activeSection;
      const searchTarget = `${item.dataset.title ?? ''} ${item.dataset.tags ?? ''}`;
      const matchKeyword = keyword === '' || searchTarget.includes(keyword);
      item.hidden = !(matchSection && matchKeyword);
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeSection = btn.dataset.section ?? 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    keyword = (searchInput.value ?? '').toLowerCase().trim();
    applyFilters();
  });
</script>

<style>
  .page-hero {
    background: var(--wm-blue);
    color: #fff;
    padding-block: 4rem;
  }

  .page-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0;
  }

  .section { padding-block: 4rem; }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-btn {
    padding: 0.375rem 1rem;
    border: 1px solid var(--wm-border);
    border-radius: 2rem;
    background: var(--wm-bg);
    color: var(--wm-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    cursor: pointer;
    min-height: var(--tap-min);
    transition: background 0.15s, border-color 0.15s;
  }

  .filter-btn:hover,
  .filter-btn.is-active {
    background: var(--wm-blue);
    color: #fff;
    border-color: var(--wm-blue);
  }

  .search-bar {
    margin-bottom: 2rem;
  }

  .keyword-input {
    width: 100%;
    max-width: 480px;
    padding: 0.625rem 1rem;
    border: 1px solid var(--wm-border);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 1rem;
    background: var(--wm-bg);
    color: var(--wm-text);
  }

  .keyword-input:focus { outline: 2px solid var(--wm-blue); outline-offset: 1px; }

  .posts-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--wm-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--wm-text);
    transition: border-color 0.15s, transform 0.15s;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--wm-blue);
    transform: translateY(-2px);
  }

  .post-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--wm-bg-soft);
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-card__section {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--wm-teal);
  }

  .post-card__date {
    font-size: 0.8125rem;
    color: var(--wm-text-muted);
  }

  .post-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--wm-blue);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .post-card__excerpt {
    font-size: 0.9375rem;
    color: var(--wm-text-muted);
    margin: 0 0 auto;
    flex: 1;
    line-height: 1.5;
  }

  .post-card__cta {
    display: block;
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--wm-teal);
  }

  .empty-state {
    color: var(--wm-text-muted);
    font-style: italic;
  }
</style>
