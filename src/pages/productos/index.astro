---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/layout/Cta.astro';
import { getCollection } from 'astro:content';

const lines = (await getCollection('lines')).sort((a, b) => a.data.order - b.data.order);
const allProducts = await getCollection('products');

// Productos activos agrupados por línea
const productsByLine = lines.map((line) => ({
  line,
  products: allProducts
    .filter((p) => p.data.lineId === line.data.id && p.data.status === 'active')
    .sort((a, b) => a.data.name.localeCompare(b.data.name, 'es')),
}));
---

<Base
  title="Productos"
  description="Catálogo de reactivos, controles, calibradores, consumibles e instrumentos de WM Argentina organizados por línea."
>
  <section class="page-hero" style="background-image: linear-gradient(rgba(0,79,146,0.75), rgba(0,79,146,0.75)), url('https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=1400&h=500&fit=crop&auto=format&q=80')">
    <div class="container">
      <h1>Productos</h1>
      <p class="lead">Encontrá el producto que necesitás por línea o usá el buscador para buscar por nombre, analito o instrumento.</p>
    </div>
  </section>

  <!-- Filtro rápido por línea (client-side) -->
  <section class="section">
    <div class="container">
      <div class="filter-bar">
        <button class="filter-btn is-active" data-line="all">Todas</button>
        {lines.map((line) => (
          <button class="filter-btn" data-line={line.data.slug}>{line.data.name}</button>
        ))}
      </div>

      {productsByLine.map(({ line, products }) => (
        <div class="line-group" data-line-group={line.data.slug}>
          <h2 class="line-heading">
            <a href={`/soluciones/${line.data.slug}`}>{line.data.name}</a>
          </h2>
          {products.length > 0 ? (
            <ul class="products-table" role="list">
              {products.map((p) => (
                <li>
                  <a href={`/productos/${p.data.slug}`} class="product-row">
                    <span class="product-row__kind">{p.data.kind}</span>
                    <span class="product-row__name">{p.data.name}</span>
                    {p.data.application && p.data.application !== 'TODO-CLIENTE' && (
                      <span class="product-row__app">{p.data.application}</span>
                    )}
                    {p.data.status === 'discontinued' && (
                      <span class="product-row__badge">Descontinuado</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty-line">TODO-CLIENTE — Catálogo de esta línea en preparación (P-12).</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <Cta
    title="¿No encontraste lo que buscás?"
    body="Hablá con nuestro equipo o buscá por nombre de analito o equipo."
    primary={{ label: 'Contactar un especialista', href: '/contacto' }}
    secondary={{ label: 'Buscar por nombre o analito', href: '/buscar' }}
  />
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const groups = document.querySelectorAll<HTMLElement>('.line-group');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const line = btn.dataset.line;
      btns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      groups.forEach((g) => {
        g.hidden = line !== 'all' && g.dataset.lineGroup !== line;
      });
    });
  });
</script>

<style>
  .page-hero {
    background-color: var(--wm-blue);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding-block: 4rem;
  }

  .page-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lead { font-size: 1.125rem; opacity: 0.9; margin: 0; max-width: 60ch; }

  .section { padding-block: 4rem; }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .filter-btn {
    padding: 0.375rem 1rem;
    border: 1px solid var(--wm-border);
    border-radius: 2rem;
    background: var(--wm-bg);
    color: var(--wm-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    cursor: pointer;
    min-height: var(--tap-min);
    transition: background 0.15s, border-color 0.15s;
  }

  .filter-btn:hover,
  .filter-btn.is-active {
    background: var(--wm-blue);
    color: #fff;
    border-color: var(--wm-blue);
  }

  .line-group {
    margin-bottom: 3rem;
  }

  .line-heading {
    font-size: 1.25rem;
    color: var(--wm-blue);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--wm-blue-tint);
  }

  .line-heading a {
    color: inherit;
    text-decoration: none;
  }

  .line-heading a:hover { text-decoration: underline; }

  .products-table {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-row {
    display: grid;
    grid-template-columns: 100px 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--wm-bg-soft);
    border-radius: 8px;
    text-decoration: none;
    color: var(--wm-text);
    transition: background 0.15s;
  }

  .product-row:hover {
    background: var(--wm-blue-tint);
    color: var(--wm-blue);
  }

  .product-row__kind {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    color: var(--wm-teal);
  }

  .product-row__name { font-weight: 500; }

  .product-row__app {
    font-size: 0.875rem;
    color: var(--wm-text-muted);
  }

  .product-row__badge {
    font-size: 0.75rem;
    background: #fff3cd;
    color: #856404;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .empty-line {
    color: var(--wm-text-muted);
    font-style: italic;
    font-size: 0.9375rem;
  }

  @media (max-width: 639px) {
    .product-row {
      grid-template-columns: 1fr;
    }
  }
</style>
