---
import Base from '../layouts/Base.astro';
import Cta from '../components/layout/Cta.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const serviceIcons: Record<string, string> = {
  'asesoramiento': 'lucide:message-circle',
  'aplicaciones': 'lucide:flask-conical',
  'instalacion-puesta-en-marcha': 'lucide:settings',
  'capacitacion': 'lucide:graduation-cap',
  'servicio-tecnico': 'lucide:wrench',
  'integracion-conectividad': 'lucide:plug',
};
---

<Base
  title="Servicios"
  description="Asesoramiento, aplicaciones, instalación, capacitación, servicio técnico e integración. WM Argentina acompaña todo el ciclo del diagnóstico."
>
  <section class="page-hero" style="background-image: linear-gradient(rgba(0,79,146,0.75), rgba(0,79,146,0.75)), url('https://images.unsplash.com/photo-1575468130797-aa950b68aeec?w=1400&h=500&fit=crop&auto=format&q=80')">
    <div class="container">
      <h1>Servicios</h1>
      <p class="lead">Acompañamos todo el ciclo: desde la instalación hasta la integración con sistemas de información.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <h2 id="services-heading" class="sr-only">Nuestros servicios</h2>
      <div class="services-grid">
        {services.map((service) => {
          const iconName = serviceIcons[service.data.slug] ?? 'lucide:circle-dot';
          return (
          <article class="service-card">
            <div class="service-card-icon" aria-hidden="true">
              <Icon name={iconName} size={28} />
            </div>
            <h3 class="service-card-name">{service.data.name}</h3>
            <p class="service-card-body">
              {service.data.body !== 'TODO-CLIENTE' ? service.data.body : service.data.summary}
            </p>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <Cta
    title="¿Necesitás soporte o asesoramiento técnico?"
    body="Nuestro equipo especializado está disponible para ayudarte en cada etapa."
    primary={{ label: 'Contactar un especialista', href: '/contacto' }}
    secondary={{ label: 'Conocer nuestras soluciones', href: '/soluciones' }}
  />
</Base>

<style>
  .page-hero {
    background-color: var(--wm-blue);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding-block: 4rem;
  }

  .page-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .lead {
    font-size: 1.125rem;
    opacity: 0.9;
    margin: 0;
    max-width: 60ch;
  }

  .section {
    padding-block: 4rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1023px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 639px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--wm-border);
    border-radius: var(--radius);
    background: var(--wm-bg);
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .service-card:hover {
    border-color: var(--wm-teal);
    box-shadow: 0 4px 16px rgba(0, 146, 152, 0.1);
  }

  .service-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--wm-teal-tint);
    color: var(--wm-teal);
    flex-shrink: 0;
  }

  .service-card-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--wm-blue);
    margin: 0;
  }

  .service-card-body {
    font-size: 0.9375rem;
    color: var(--wm-text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
