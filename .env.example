# WM Argentina — variables de entorno
# Copiar este archivo como .env y completar los valores.

# Modo revisión de contenido:
# Activa los tags de validación en todas las páginas del sitio.
# Solo usar en el entorno de revisión con el cliente — nunca en producción.
PUBLIC_REVIEW_MODE=true

# URL del sitio (para canónicas y OG). Sin barra final.
# SITE_URL=https://wmargentina.com.ar
